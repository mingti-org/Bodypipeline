{
  "root": ".runtime/server",
  "processing_mode": "real",
  "auto_process": false,
  "profiles": {
    "agilex_aloha": {
      "profile_path": "configs/agilex-aloha-v2.json",
      "provider": "agilex",
      "raw_formats": ["agilex_joint_camera_hdf5_v1", "agilex_timestamped_directory_v1"],
      "accepted_capture_profile_hashes": []
    }
  },
  "default_profile": "agilex_aloha",
  "flora": {
    "enabled": false,
    "src": "/workspace/flora/Flora-TempSeg",
    "python": "/workspace/flora/.venv-annotation/bin/python",
    "srun": "srun",
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe",
    "model_cache": "/workspace/flora/models",
    "hf_home": "/workspace/flora/huggingface",
    "hf_endpoint": "https://hf-mirror.com",
    "partition": "dev",
    "gpus": 1,
    "cpus_per_task": 8,
    "timeout_seconds": 14400,
    "profiles": {
      "agilex": {
        "profile": "yam",
        "yam32": false,
        "camera_roles": {
          "main": "observation.images.front",
          "left_wrist": "observation.images.left_wrist",
          "right_wrist": "observation.images.right_wrist"
        }
      }
    }
  },
  "viewer_origin": "http://127.0.0.1:8082"
}
